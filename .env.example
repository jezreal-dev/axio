# ============================================================================
# IncidentWhy — Environment Configuration (.env.example)
# Copy to `.env` for local overrides:  cp .env.example .env
# By default SAMPLE_MODE=true runs 100% offline with zero external credentials.
# ============================================================================

# --- Offline / Judge Evaluation Mode (default: true) ---
SAMPLE_MODE=true
USE_LLM=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
MAX_ROUNDS=4
HYPOTHESIS_BATCH_SIZE=2

# --- Primary provider: Meterless Nightshift ---
# Put NVIDIA credentials in Nightshift Setup > Providers, not here.
MODEL_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# --- Optional legacy direct NVIDIA provider: MODEL_PROVIDER=nvidia ---
# Get your API key from https://build.nvidia.com
MODEL_API_KEY=your-nvidia-api-key-here
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_REASONING=nvidia/llama-3.3-nemotron-super-49b-v1
MODEL_FAST=nvidia/nvidia-nemotron-nano-9b-v2
MODEL_TIMEOUT_S=60

# --- Sponsor 2: Zetaris Federated Data Plane ---
# When SAMPLE_MODE=false and ZETARIS_API_KEY is set, queries execute against
# the Zetaris REST API (/sql-editor/sqls/run) with X-Org-ID and X-Request-ID.
ZETARIS_REST_URL=https://api.zetaris.com
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_TIMEOUT_S=30
ZETARIS_CATALOG_BILLING=billing
ZETARIS_CATALOG_TELEMETRY=telemetry
ZETARIS_CATALOG_OPS=ops
